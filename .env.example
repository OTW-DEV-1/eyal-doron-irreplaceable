# All optional — the site renders fully without any of these. The contact form
# accepts a lead if ANY configured channel (Zapier / Resend / Supabase) took it.

# Supabase: lead storage + (optionally) serving /public/assets from Storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_BUCKET=site-assets
SUPABASE_SECRET_KEY=

# Resend: email relay for contact-form submissions.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Zapier webhook that receives each lead as JSON (overridable at /admin/settings).
ZAPIER_WEBHOOK_URL=

# Password for /admin/leads + /admin/settings.
ADMIN_PASSWORD=
